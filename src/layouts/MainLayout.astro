---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from "../consts";
// Supports weights 100-900
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/space-grotesk";
import displayFontUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title: pageTitle,
  description: pageDesc,
  image: pageImage,
  imageAlt: pageImageAlt,
  type,
  publishedTime,
  modifiedTime,
  noindex,
} = Astro.props;
const title = pageTitle ?? SITE_TITLE;
const description = pageDesc ?? SITE_DESCRIPTION;
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const jsonLd = isHomepage
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${SITE_URL}/#person`,
          name: "Oswaldo Roberto Huillca Huamani",
          alternateName: "Oswa",
          url: SITE_URL,
          jobTitle: "Desarrollador Web Full Stack",
          description: SITE_DESCRIPTION,
          image: `${SITE_URL}/images/oswaldo-retrato.webp`,
        },
        {
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: "Oswaldo Huillca - Portfolio",
          description: SITE_DESCRIPTION,
          publisher: { "@id": `${SITE_URL}/#person` },
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={pageImage ?? "/images/oswaldo-retrato.webp"}
      imageAlt={pageImageAlt ?? "Oswaldo Huillca - Desarrollador Web Full Stack"}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    >
      {jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )}
      <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    </BaseHead>
    <script is:inline>
      // Antes del primer pintado para evitar el parpadeo. Otro valor (como el antiguo "default") sigue al sistema.
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem("hs_theme");
        } catch (e) {}
        var dark =
          theme === "dark" ||
          (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-lg focus:bg-background focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
