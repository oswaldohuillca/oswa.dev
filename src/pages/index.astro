---
import { getCollection } from "astro:content";
import Project from "../components/home/Project.astro";
import MainLayout from "../layouts/MainLayout.astro";
import TimelineItem from "../components/home/TimelineItem.astro";
import { Image } from "astro:assets";
import Link from "../components/Link.astro";
import Blog from "../components/home/Blog.astro";

const projects = (await getCollection("project")).sort(
  (a, b) => a.data.createAt.valueOf() - b.data.createAt.valueOf()
);
---

<MainLayout>
  <main>
    <section class="min-h-[655px] flex items-center container relative">
      <div class="relative z-10 max-w-[800px]">
        <p class="text-brand-strong dark:text-brand font-semibold mb-6">
          Desarrollador Web Full Stack
        </p>
        <h1 class="text-5xl md:text-6xl text-balance leading-[1.05] mb-8">
          Hola, soy <strong class="text-brand-strong dark:text-brand"
            >Oswaldo</strong
          >. Construyo la web que usas todos los días.
        </h1>
        <Link href="/CV-Oswaldo.pdf" download="CV-Oswa.pdf">
          Descargar CV
          <span class="icon-[iconamoon--cloud-download]"></span>
        </Link>
      </div>
      <span
        class="intro-dark w-[55%] h-[55%] absolute top-0 -right-[10%] bottom-0 my-auto z-0"
      ></span>
    </section>

    <section class="container">
      <header class="max-w-[620px] mb-24">
        <span
          class="inline-block h-px w-10 align-middle bg-brand mr-3 mb-1.5"
        ></span>
        <span class="text-sm font-semibold text-brand-strong dark:text-brand"
          >Trayectoria</span
        >
        <h2 class="text-4xl mt-4 mb-4">Mi Experiencia</h2>
        <p class="text-muted-foreground">
          Últimas empresas donde me he desempeñado y aportado en diferentes
          proyectos como desarrollador Web.
        </p>
      </header>
      <div class="mb-24 lg:w-[80%]">
        <TimelineItem
          date="01 Octubre, 2022 - Actualmente"
          title="Desarrollador Full Stack (PHP, Mysql, JavaScript, NextJs, PostgreSQL, Laravel)"
          company="apros.global"
          companyLink="https://apros.global"
        >
          <p>
            Implementé una plantilla para mejorar la experiencia de desarrollo y
            mejorar el rendimiento de los sitios Web, evitando el uso excesivo
            de plugins de Wordpress que invaden con gigantescos archivos que lo
            componen.
          </p>
        </TimelineItem>
        <TimelineItem
          date="28 enero, 2022"
          title="Desarrollador Full Stack (NextJs, MongoDB)"
          company="Clinica San Carlos"
        >
          <p>
            Participé en el desarrollo de un software interno de la empresa para
            la gestión de historias y citas medicas.
          </p>
        </TimelineItem>

        <TimelineItem
          date="Febrero, 2021"
          title="Desarrollador Full Stack (LAMP)"
          company="EEGSAC"
        >
          <p>
            Tuve la oportunidad de mejorar una herramienta interna de la empresa
            el cual se usa para generar certificados, implemtentos diferentes
            funcionalidades como busqueda, filtrado y asignación mediante
            códigos QR.
          </p>
        </TimelineItem>
      </div>
    </section>

    <section class="container py-20 md:py-28">
      <header
        class="flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-16 mb-10 md:mb-24"
      >
        <h2 class="text-4xl">
          Proyectos
          <sup class="text-base font-semibold text-brand-strong dark:text-brand"
            >({projects.length})</sup
          >
        </h2>
        <p class="md:max-w-[420px]">
          Algunos de los proyectos en los que he liderado, participado y
          construido independiente.
        </p>
      </header>
      {
        projects.map((project, index) => (
          <Project project={project} index={index + 1} />
        ))
      }
    </section>

    <section class="container py-20 md:py-28">
      <header class="mb-10 md:mb-24">
        <h2 class="text-4xl md:text-5xl max-w-[640px]">Te cuento sobre mí</h2>
        <p class="text-muted-foreground mt-4">
          Un breve resumen sobre mi vida profesional.
        </p>
      </header>

      <div class="flex flex-col md:flex-row items-center gap-10">
        <div
          class="[&_p]:mb-4 [&_strong]:text-brand-strong dark:[&_strong]:text-brand [&_a]:text-brand-strong dark:[&_a]:text-brand flex-1"
        >
          <p>
            Mi nombre completo es <strong
              >Oswaldo Roberto Huillca Huamani</strong
            >
            pero suelen llamarme <strong>Oswa</strong> para que no sea muy largo.
            No hace mucho estoy en el mundo de la programación, profesionalmente
            empece hace 4 años hasta la fecha.
          </p>

          <p>
            Como desarrollador Web he participado en diferentes retos, algunos
            sencillos, complejos y otros con posibilidad de mejora. Es así que en
            mi última empresa he desarrollado 2 herramientas que nos ayudan a
            mejorar el desarrollo, reduciendo el tiempo:
            <a
              href="https://github.com/oswaldohuillca/unocss-preset-calc"
              target="_blank"
              class="underline"
            >
              UnoCSS preset calc
            </a> el cual nos permite crear interfaces identicas al diseño UI de
            <i>Figma</i> u otras herramientas de diseño UI.
            <a
              href="https://github.com/oswaldohuillca/wp-dev-kit-started"
              target="_blank"
              class="underline"
            >
              WP Started Dev Kit
            </a> Nos ayuda a crear plantillas <i>Wordpress</i> rápidamente con alto
            grado de customización utilizando herramientas como AFC.
          </p>

          <p>
            Como reto personal profesional, espero mejorar constantemente y
            aprender nuevas tecnologías para, más adelante, crear herramientas
            que ayuden a los usuarios a tener una vida menos compleja.
          </p>
        </div>
        <figure class="grow-0 md:max-w-[30%]">
          <Image
            src="/images/oswaldo-huillca.webp"
            width={600}
            height={600}
            alt="Oswaldo Roberto Huillca Huamani"
            class="min-h-10 rounded-lg"
          />
        </figure>
      </div>
    </section>

    <Blog />
  </main>
</MainLayout>
