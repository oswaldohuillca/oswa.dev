---
import { type CollectionEntry, getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Link from "../../components/Link.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("project");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"project">;

const project = Astro.props;
const { Content } = await project.render();
---

<MainLayout
  title={`${project.data.title} | Oswaldo Huillca`}
  description={project.data.description}
  image={project.data.heroImage}
  imageAlt={project.data.title}
  type="article"
  publishedTime={project.data.createAt.toISOString()}
>
  <section class="container pt-24">
    <div class="flex flex-col gap-4 md:flex-row">
      <aside class="md:min-w-[380px]">
        <div class="h-full">
          <div class="sticky top-24">
            <h1
              class="text-2xl md:text-4xl mb-2 text-brand-strong dark:text-brand font-bold text-balance"
            >
              {project.data.title}
            </h1>
            <FormattedDate date={project.data.createAt} />
            {
              project.data.status && (
                <p class="mt-2 text-sm text-muted-foreground">
                  {project.data.status}
                </p>
              )
            }
            {
              (project.data.website || project.data.github) && (
                <div class="mt-6 flex flex-wrap items-center gap-1">
                  {project.data.website && (
                    <Link
                      href={project.data.website}
                      target="_blank"
                      rel="noopener"
                    >
                      Ver sitio
                      <span class="icon-[iconoir--internet]" />
                    </Link>
                  )}
                  {project.data.github && (
                    <Link
                      href={project.data.github}
                      target="_blank"
                      rel="noopener"
                    >
                      Repositorio
                      <span class="icon-[ant-design--github-outlined]" />
                    </Link>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </aside>
      <div class="mdx min-w-0 flex-1">
        {
          project.data.heroImage && (
            <Image
              src={project.data.heroImage}
              alt={project.data.title}
              format="webp"
              width={650}
              height={650}
              class="max-h-[300px] object-cover object-top"
            />
          )
        }
        <Content />
      </div>
    </div>
  </section>
</MainLayout>
