---
import { PAGE_TITLE } from "../consts";

const sections = [
	{ href: "/#herramientas", label: "Herramientas" },
	{ href: "/#proyectos", label: "Proyectos" },
	{ href: "/#experiencia", label: "Experiencia" },
	{ href: "/#sobre-mi", label: "Sobre mí" },
];
const navLink =
	"inline-flex h-11 items-center rounded-md px-2 text-sm hover:text-brand-strong dark:hover:text-brand transition-colors";
const iconButton =
	"flex size-11 items-center justify-center rounded-lg text-xl hover:text-brand-strong dark:hover:text-brand transition-colors";
---

<header
	class="fixed top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur [@media(max-height:500px)]:static"
>
	<nav class="w-full" aria-label="Principal">
		<div class="container flex items-center justify-between gap-2 py-3">
			<a
				href="/"
				class="text-2xl font-bold tracking-tight whitespace-nowrap"
				style="font-family: var(--font-display)">{PAGE_TITLE}</a
			>
			<div class="flex items-center font-semibold">
				{
					sections.map(({ href, label }) => (
						<a href={href} class:list={[navLink, "max-md:hidden"]}>
							{label}
						</a>
					))
				}
				<a href="#contacto" class={navLink}>Contacto</a>
				<a
					href="https://github.com/oswaldohuillca"
					target="_blank"
					rel="nofollow noopener"
					aria-label="GitHub de Oswaldo (abre en otra pestaña)"
					class={iconButton}
				>
					<span class="icon-[iconoir--github]"></span>
				</a>
				<button
					type="button"
					data-theme-toggle
					aria-pressed="false"
					aria-label="Tema oscuro"
					class:list={[iconButton, "text-muted-foreground"]}
				>
					<span class="icon-[iconoir--half-moon] dark:hidden"></span>
					<span class="hidden dark:block">
						<span class="icon-[iconoir--sun-light] block"></span>
					</span>
				</button>
			</div>
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
	const sync = () =>
		toggle.setAttribute("aria-pressed", String(root.classList.contains("dark")));
	sync();

	toggle.addEventListener("click", () => {
		const dark = root.classList.toggle("dark");
		sync();
		localStorage.setItem("hs_theme", dark ? "dark" : "light");
	});

	matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
		const saved = localStorage.getItem("hs_theme");
		if (saved === "dark" || saved === "light") return;
		root.classList.toggle("dark", e.matches);
		sync();
	});
</script>
