---
import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../libs/utils";

interface Props extends HTMLAttributes<"a"> {
  variant?: "default" | "primary";
  size?: "default" | "icon";
}

const { class: className, variant, size, ...others } = Astro.props;

// "",
const buttonVariants = cva(
  " inline-flex items-center gap-x-2 text-sm font-medium rounded-full border shadow-sm transition-colors disabled:opacity-50 disabled:pointer-events-none",
  {
    variants: {
      variant: {
        default:
          "border-border bg-background text-foreground hover:border-brand hover:text-brand-strong dark:hover:text-brand",
        // Oscuro: el acento es claro, así que el texto va oscuro para mantener el contraste.
        primary:
          "border-transparent bg-brand-strong text-white hover:bg-brand dark:bg-brand dark:text-[#121212] dark:hover:bg-brand-strong",
      },
      size: {
        default: "h-11 px-4",
        icon: "size-11 justify-center text-xl",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  },
);
---

<a {...others} class={cn(buttonVariants({ variant, size, className }))}>
  <slot />
</a>
