---
import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../libs/utils";

interface Props extends HTMLAttributes<"a"> {
  variant?: "default";
  size?: "default" | "icon";
}

const { class: className, variant, size, ...others } = Astro.props;

// "",
const buttonVariants = cva(
  " inline-flex items-center gap-x-2 text-sm font-medium rounded-full border border-border bg-background text-foreground shadow-sm transition-colors hover:border-brand hover:text-brand-strong dark:hover:text-brand disabled:opacity-50 disabled:pointer-events-none",
  {
    variants: {
      variant: {
        default: "",
      },
      size: {
        default: "h-10 px-4 py-3",
        icon: "p-2 text-xl",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  },
);
---

<a {...others} class={cn(buttonVariants({ variant, size, className }))}>
  <slot />
</a>
