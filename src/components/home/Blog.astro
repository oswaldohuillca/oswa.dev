---
import { fDate } from "@libs/date";

interface Post {
  title: string;
  description: string;
  url: string;
  publishedAt: string;
  coverImage: string;
  markdown: string;
}

interface PostsResponse {
  id: number;
  title: string;
  description: string;
  url: string;
  published_timestamp: string;
  cover_image: string;
  body_markdown: string;
}

let devToPost: PostsResponse[] = [];
try {
  const res = await fetch("https://dev.to/api/articles/me/published", {
    headers: {
      "api-key": import.meta.env.DEVTO_API_KEY ?? "",
    },
  });
  const data = await res.json();
  if (Array.isArray(data)) devToPost = data;
} catch (error) {
  console.warn("No se pudieron cargar los posts de dev.to:", error);
}

const posts: Post[] = devToPost.map((post: PostsResponse) => ({
  title: post.title,
  description: post.description,
  url: post.url,
  publishedAt: post.published_timestamp,
  coverImage: post.cover_image,
  markdown: post.body_markdown,
}));
---

{posts.length > 0 && (
<section class="container py-24 md:py-32">
  <header class="max-w-[620px] mb-14">
    <h2 class="text-4xl md:text-5xl">Escribo</h2>
    <p class="text-muted-foreground mt-4">
      Artículos que publico en dev.to sobre desarrollo web. El detalle abre en
      dev.to.
    </p>
  </header>
  <ul>
    {
      posts.map((post, index) => (
        <li>
          <a
            href={post.url}
            target="_blank"
            rel="noopener"
            class="group grid md:grid-cols-[3.5rem_1fr_auto] gap-x-8 gap-y-1 items-baseline py-6 border-t border-border transition-colors hover:border-brand"
          >
            <span class="text-sm tabular-nums text-muted-foreground">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="text-xl md:text-2xl group-hover:text-brand-strong dark:group-hover:text-brand transition-colors">
              {post.title}
            </span>
            <span class="flex items-center gap-2 text-sm tabular-nums text-muted-foreground">
              <time datetime={post.publishedAt}>{fDate(post.publishedAt)}</time>
              <span class="icon-[iconoir--arrow-up-right] opacity-0 group-hover:opacity-100 transition-opacity" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
)}
