---
import { cn } from "../../libs/utils";
import TextOutline from "./TextOutline.astro";
import { fDate } from "@libs/date";

interface Post {
  title: string;
  description: string;
  url: string;
  publishedAt: string;
  coverImage: string;
  markdown: string;
}

interface PostsResponse {
  id: number;
  title: string;
  description: string;
  url: string;
  published_timestamp: string;
  cover_image: string;
  body_markdown: string;
}

let devToPost: PostsResponse[] = [];
try {
  const res = await fetch("https://dev.to/api/articles/me/published", {
    headers: {
      "api-key": import.meta.env.DEVTO_API_KEY ?? "",
    },
  });
  const data = await res.json();
  if (Array.isArray(data)) devToPost = data;
} catch (error) {
  console.warn("No se pudieron cargar los posts de dev.to:", error);
}

const posts: Post[] = devToPost.map((post: PostsResponse) => ({
  title: post.title,
  description: post.description,
  url: post.url,
  publishedAt: post.published_timestamp,
  coverImage: post.cover_image,
  markdown: post.body_markdown,
}));
---

{posts.length > 0 && (
<section class="container my-32">
  <header class="mb-24 text-center">
    <h2 class="text-4xl md:text-5xl">Blog</h2>
    <p class="text-muted-foreground mt-4">
      Puede que encuentres algún artículo interesante.
    </p>
  </header>
  <div class="grid md:grid-cols-2 relative">
    {
      posts.map((post, index) => {
        const isEven = index % 2 === 0;

        return (
          <article
            class={cn("border-dashed p-4 md:p-16 relative z-10", {
              "border-b border-r border-b-primary md:border-r-primary": isEven,
              "border-b border-b-primary ": !isEven,
            })}
          >
            <TextOutline>0{index + 1}</TextOutline>
            <h3 class="text-3xl">{post.title}</h3>
            <div class="mt-3 flex items-center gap-4">
              <time datetime={post.publishedAt} class="text-sm text-muted-foreground">
                {fDate(post.publishedAt)}
              </time>
              <a
                href={post.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-x-1 text-sm font-semibold text-brand-strong hover:underline dark:text-brand"
              >
                Leer más
                <span class="icon-[iconoir--arrow-right]"></span>
              </a>
            </div>
          </article>
        );
      })
    }
    <span
      class="custom-blur absolute top-0 left-0 bottom-0 right-0 m-auto w-[50%] h-[50%] z-0"
    ></span>
  </div>
</section>
)}
