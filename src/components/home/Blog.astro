---
import FormattedDate from "../FormattedDate.astro";

interface Post {
  title: string;
  description: string;
  url: string;
  publishedAt: string;
  coverImage: string;
  markdown: string;
}

interface PostsResponse {
  id: number;
  title: string;
  description: string;
  url: string;
  published_timestamp: string;
  cover_image: string;
  body_markdown: string;
}

let devToPost: PostsResponse[] = [];
try {
  const res = await fetch("https://dev.to/api/articles/me/published", {
    headers: {
      "api-key": import.meta.env.DEVTO_API_KEY ?? "",
    },
  });
  const data = await res.json();
  if (Array.isArray(data)) devToPost = data;
} catch (error) {
  console.warn("No se pudieron cargar los posts de dev.to:", error);
}

const posts: Post[] = devToPost.map((post: PostsResponse) => ({
  title: post.title,
  description: post.description,
  url: post.url,
  publishedAt: post.published_timestamp,
  coverImage: post.cover_image,
  markdown: post.body_markdown,
}));
---

{posts.length > 0 && (
<section
  id="articulos"
  class="container grid grid-cols-1 gap-x-16 gap-y-10 py-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
>
  <header class="lg:sticky lg:top-24 lg:self-start">
    <h2 class="text-4xl md:text-5xl font-bold">Artículos</h2>
    <p class="text-muted-foreground mt-4">
      Artículos que publico en dev.to sobre desarrollo web. El detalle abre en
      dev.to.
    </p>
  </header>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a
            href={post.url}
            target="_blank"
            rel="noopener"
            class="group grid md:grid-cols-[1fr_auto] gap-x-8 gap-y-1 items-baseline py-6 border-t border-border transition-colors hover:border-brand"
          >
            <span class="text-xl md:text-2xl group-hover:text-brand-strong dark:group-hover:text-brand transition-colors">
              {post.title}
            </span>
            <span class="flex items-center gap-2 text-sm tabular-nums text-muted-foreground">
              <FormattedDate date={new Date(post.publishedAt)} />
              <span class="icon-[iconoir--arrow-up-right]" aria-hidden="true" />
              <span class="sr-only">(abre en otra pestaña)</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
)}
