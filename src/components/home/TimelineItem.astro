---
interface Props {
  date: string | Date;
  title: string;
  company: string;
  companyLink?: string;
}

const { date, title, company, companyLink } = Astro.props;
const label = typeof date === "string" ? date : new Date(date).toDateString();
---

<article
  class="grid md:grid-cols-[11rem_1fr] gap-2 md:gap-10 py-8 border-t border-border first:border-t-0"
>
  <div class="text-sm text-muted-foreground tabular-nums md:pt-1">
    {label}
  </div>
  <div>
    <h3 class="text-lg md:text-xl font-bold text-balance">
      {title}
    </h3>
    <p class="text-sm font-semibold text-brand-strong dark:text-brand mt-1">
      {
        companyLink ? (
          <a
            href={companyLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block -my-3 py-3 hover:underline"
          >
            {company}
            <span class="sr-only"> (abre en otra pestaña)</span>
          </a>
        ) : (
          company
        )
      }
    </p>
    <div class="mt-3 text-muted-foreground max-w-[62ch] [&_p]:leading-relaxed">
      <slot />
    </div>
  </div>
</article>
