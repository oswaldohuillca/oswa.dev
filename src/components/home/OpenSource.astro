---
/* Hallmark · component: open-source index · genre: modern-minimal · theme: Cobalt
 * states: default · hover · focus · active · disabled · loading · error · success
 * Índice tipográfico: la fila no lleva captura — el nombre, el comando de
 * instalación y los enlaces son todo el contenido que existe de verdad.
 */
import type { CollectionEntry } from "astro:content";

import Link from "../Link.astro";
import Badge from "../Badge.astro";
import CopyButton from "../CopyButton.astro";

interface Props {
  project: CollectionEntry<"project">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, description, tags, github, website, install, registry, status } =
  project.data;

const registryLabel: Record<string, { label: string; icon: string }> = {
  npm: { label: "npm", icon: "icon-[iconoir--npm]" },
  packagist: { label: "Packagist", icon: "icon-[iconoir--package]" },
};

const meta = registry ? registryLabel[registry] : undefined;
---

<article
  class="border-t border-border py-8 md:py-10 first:border-t-0 first:pt-0"
>
  <div
    class="flex flex-col gap-y-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-6"
  >
    <h3
      class:list={[featured ? "text-3xl md:text-4xl" : "text-2xl md:text-3xl"]}
    >
      <a href={`/project/${project.slug}/`} class="hover:underline hover:text-brand-strong dark:hover:text-brand">
        {title}
      </a>
    </h3>
    {
      meta && (
        <p class="flex shrink-0 items-center gap-x-1.5 text-sm text-muted-foreground">
          <span class={meta.icon} aria-hidden="true" />
          {meta.label}
        </p>
      )
    }
    {
      !meta && status && (
        <p class="shrink-0 text-sm text-muted-foreground">{status}</p>
      )
    }
  </div>

  <p class="mt-3 max-w-[58ch] text-muted-foreground">{description}</p>

  {
    install && (
      <div class="mt-5 flex max-w-full items-center gap-x-2 overflow-hidden rounded-lg border border-border bg-muted/40 ps-3 pe-1">
        <code tabindex="0" class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-1.5 font-mono text-sm text-foreground">
          {install}
        </code>
        <CopyButton text={install} label={`Copiar «${install}»`} />
      </div>
    )
  }

  {
    tags && (
      <div class="mt-5 flex flex-wrap gap-1">
        {tags.map((tag) => (
          <Badge>{tag}</Badge>
        ))}
      </div>
    )
  }

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <Link href={`/project/${project.slug}/`} aria-label={`Leer más sobre ${title}`}>
      Leer más
    </Link>
    {
      website && (
        <Link
          href={website}
          size="icon"
          target="_blank"
          rel="noopener"
          aria-label={`Sitio de ${title} (abre en otra pestaña)`}
        >
          <span class="icon-[iconoir--internet]" />
        </Link>
      )
    }
    {
      github && (
        <Link
          href={github}
          size="icon"
          target="_blank"
          rel="noopener"
          aria-label={`Repositorio de ${title} (abre en otra pestaña)`}
        >
          <span class="icon-[iconoir--github]" />
        </Link>
      )
    }
  </div>
</article>
